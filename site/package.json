{
  "name": "quartic-reader-site",
  "private": true,
  "version": "0.1.0",
  "description": "Read OpenAI's nearly quartic separation and three accounts of it beside the Quartic project's Lean proof.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "data": "node scripts/link-data.mjs",
    "dev": "node scripts/link-data.mjs && vite",
    "build": "node scripts/check-title-math.mjs && tsc --noEmit && vite build && node scripts/link-data.mjs --copy dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/stix-two-text": "5.3.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
