per.ConstructionForrelationDefinitions","receipt":"corpus/reading_statement_evidence.json","status":"current","type":"∀ (k t : ℕ),\n  1 ≤ k →\n    ∀ (z : QuarticQuery.BitInput (QuarticQuery.ForrelationCoord k t)),\n      (↑(QuarticQuery.forrelationNumerator k t z) =\n          (fun x => 1) ⬝ᵥ\n            (QuarticQuery.Forrelation.alternate (QuarticQuery.Forrelation.W t)\n                  (List.ofFn fun h => QuarticQuery.Forrelation.signDiag z h)).mulVec\n              fun x => 1) ∧\n        QuarticQuery.Phi k t z =\n            ↑(QuarticQuery.forrelationNumerator k t z) / ↑(QuarticQuery.forrelationDenominator k t) ∧\n          0 < QuarticQuery.forrelationDenominator k t ∧\n            ↑(QuarticQuery.forrelationDenominator k t) =\n                ↑(QuarticQuery.mValue t) * √↑(QuarticQuery.mValue t) ^ (k - 1) ∧\n              QuarticQuery.Forrelation.W t = √↑(QuarticQuery.mValue t) • QuarticQuery.Forrelation.H t ∧\n                ∀ (i j : Fin (QuarticQuery.mValue t)),\n                  QuarticQuery.Forrelation.W t i j = 1 ∨ QuarticQuery.Forrelation.W t i j = -1"},"kind":"theorem","line":141,"note":"The integer numerator is the matrix word with the first diagonal absorbed by the ones vector; the theorem also states Φ=N/M, positive M=m(√m)^(k−1), W=√m H and ±1 entries.","open_assumptions":[],"premises":["k ≥ 1; m=4^t."],"reached":false,"relation":"exact","review_binding":{"declaration":"QuarticQuery.Paper.construction_N_phi","judgment_sha256":"003b43a19070e3703161e719e8d025c37330a397bf552c43fa5b6f228dae4ed6","row_sha256":"dc8efad8b7997578ad85a5c7d08f1f5eb7d2e2d242132ddc65f418aaafe525b6","schema":"quartic-tie-review-v1","source_snapshot_sha256":"0d109ea9e9b7f4a766640d406409e30589fb4c5a4e645b6d6888569fa2edf29f","statement_id":"claim-N-phi","statement_sha256":"a815e794227b78ce23e065741a5466c2ae632c5d9012a56f8885f73ccf3c5730"},"review_evidence":"current","reviewed_by":"ai:round3-foundation-source-review","reviewed_relation":"exact","reviewed_route":"same","route":"same","wrapper_comparison_evidence":"not_run"}],"ledger_history":{"added_in_review":false,"adjudication_findings":[],"earlier_ledger_wording":null,"wording_changed":false},"original_statement_sha256":"a815e794227b78ce23e065741a5466c2ae632c5d9012a56f8885f73ccf3c5730","passages":["forr_integer","CAT-claim-N-phi"],"review_scope":{"compared_text":"maintained_ledger_statement","leading_matches":[{"declaration":"QuarticQuery.Paper.construction_N_phi","file":"lean/QuarticQuery/Paper/ConstructionForrelationDefinitions.lean"}],"relation_origin":"authored_review","semantic_examples":"none_indexed","type_and_axioms_origin":"compiled_lean_environment"},"section":"2.1","semantic_probes":[],"source_line":183,"statement":"With W=sqrt(m) H (entries +-1), N = z_1^T W D_{z_2} W ... W D_{z_k} (1,...,1)^T is an integer, Phi=N/M_{k,m}, and M_{k,m}=m (sqrt m)^{k-1} is a positive integer because m is a power of four.","statement_sha256":"a815e794227b78ce23e065741a5466c2ae632c5d9012a56f8885f73ccf3c5730"}
