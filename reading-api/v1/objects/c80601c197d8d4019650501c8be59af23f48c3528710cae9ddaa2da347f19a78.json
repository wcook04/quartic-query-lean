eses":[],"inspection":null,"kind":"theorem","line":180,"note":"W W^T = m I over the reals.","open_assumptions":[],"premises":[],"reached":true,"relation":"unassessed","review_evidence":"legacy_unbound","reviewed_by":"ai:truth-auditor","reviewed_relation":"partial","reviewed_route":"none","route":"unassessed","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_credit":"none","comparison_evidence":"not_run","configured_checks":[],"declaration":"QuarticQuery.Paper.construction_abs_walshN","declaration_lines":[45,51],"file":"lean/QuarticQuery/Paper/ConstructionArithmetic.lean","hypotheses":[],"inspection":null,"kind":"theorem","line":46,"note":"","open_assumptions":[],"premises":[],"reached":false,"relation":"unassessed","review_evidence":"not_reviewed","reviewed_by":null,"reviewed_relation":"unassessed","reviewed_route":"unassessed","route":"unassessed","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_credit":"none","comparison_evidence":"not_run","configured_checks":[],"declaration":"QuarticQuery.Paper.construction_forr_sqrt_mValue","declaration_lines":[19,24],"file":"lean/QuarticQuery/Paper/ConstructionForrelationDefinitions.lean","hypotheses":[],"inspection":null,"kind":"theorem","line":21,"note":"","open_assumptions":[],"premises":[],"reached":false,"relation":"unassessed","review_evidence":"not_reviewed","reviewed_by":null,"reviewed_relation":"unassessed","reviewed_route":"unassessed","route":"unassessed","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_credit":"none","comparison_evidence":"not_run","configured_checks":[],"declaration":"QuarticQuery.Paper.construction_walsh_definitions","declaration_lines":[26,46],"file":"lean/QuarticQuery/Paper/ConstructionForrelationDefinitions.lean","hypotheses":[],"inspection":{"axioms":["Classical.choice","Quot.sound","propext"],"module":"QuarticQuery.Paper.ConstructionForrelationDefinitions","receipt":"corpus/reading_statement_evidence.json","status":"current","type":"∀ (k t : ℕ) (z : QuarticQuery.BitInput (QuarticQuery.ForrelationCoord k t)),\n  (∀ (b : Bool), QuarticQuery.bitSign b = (-1) ^ if b = Bool.true then 1 else 0) ∧\n    (∀ (i j : Fin (QuarticQuery.mValue t)),\n        QuarticQuery.walshSign t i j =\n          (-1) ^ ∑ b ∈ Finset.range (2 * t), if ((↑i).testBit b && (↑j).testBit b) = Bool.true then 1 else 0) ∧\n      (∀ (i j : Fin (QuarticQuery.mValue t)),\n          QuarticQuery.Forrelation.H t i j = (√↑(QuarticQuery.mValue t))⁻¹ * ↑(QuarticQuery.walshSign t i j)) ∧\n        (∀ (i : Fin (QuarticQuery.mValue t)), QuarticQuery.Forrelation.u t i = (√↑(QuarticQuery.mValue t))⁻¹) ∧\n          ∀ (h : Fin k),\n            QuarticQuery.Forrelation.signDiag z h = Matrix.diagonal fun i => ↑(QuarticQuery.bitSign (z (h, i)))"},"kind":"theorem","line":28,"note":"Conjoins bit signs, Walsh parity entries, normalized H, uniform u and sign diagonals. Statement.lean mValue=2^(2t), walshSign and forrelation definitions, and construction_forr_sqrt_mValue make the interpretation exact.","open_assumptions":[],"premises":["m = 4^t; arbitrary k sign strings."],"reached":false,"relation":"exact","review_binding":{"declaration":"QuarticQuery.Paper.construction_walsh_definitions","judgment_sha256":"ec9f4562afe588ec8c1ba2c74d7db33d7d7b89d72940151286dfde51bda74f3a","row_sha256":"cc0b6779f1b64985db8cfe3a47685bd15995c679b00236656f0f27af0f98d5a9","schema":"quartic-tie-review-v1","source_snapshot_sha256":"0d109ea9e9b7f4a766640d406409e30589fb4c5a4e645b6d6888569fa2edf29f","statement_id":"def-walsh-sign","statement_sha256":"cea0c236eec7f144a63eb21757f43457a4d6562214b0ec6e2e96438e9fcbb7e1"},"review_evidence":"current","reviewed_by":"ai:round3-foundation-source-review","reviewed_relation":"exact","reviewed_route":"none","route":"none","wrapper_comparison_evidence":"not_run"}],"ledger_history":{"added_in_review":false,"adjudication_findings":[],"earlier_ledger_wording":null,"wording_changed":false},"original_statement_sha256":"cea0c236eec7f144a63eb21757f43457a4d6562214b0ec6e2e96438e9fcbb7e1","passages":["forr_definition","CAT-def-walsh-sign"],"presentation":{"body":"Let $m=4^t$. The normalized Walsh–Hadamard matrix $H$ has dimensions $m\\times m$ and entries $H_{a,b}=m^{-1/2}(-1)^{\\langle a,b\\rangle}$ for $a,b\\in\\{0,1\\}^{\\log_2 m}$. Set $u=m^{-1/2}(1,\\ldots,1)^{\\mathsf T}$. Identify a bit $a$ with the sign $(-1)^a$. For $z\\in\\{\\pm1\\}^m$, set $D_z=\\operatorname{diag}(z)$.","body_plain":"Let m = 4ᵗ. The normalized Walsh–Hadamard matrix H has dimensions m × m and entries Hₐ,ᵦ = m⁻¹ᐟ²(−1)^⟨a,b⟩ for a, b ∈ the set of binary strings of length log₂ m. Set u = m⁻¹ᐟ²(1, …, 1)ᵀ. Identify a bit a with the sign (−1)ᵃ. For z ∈ the set of length-m sign vectors, set D(z) = diag(z).","statement_sha256":"cea0c236eec7f144a63eb21757f43457a4d6562214b0ec6e2e96438e9fcbb7e1","title":"Walsh matrices, uniform states, and sign diagonals","title_plain":"Walsh matrices, uniform states, and sign diagonals"},"review_scope":{"compared_text":"maintained_ledger_statement","leading_matches":[{"declaration":"QuarticQuery.Paper.construction_walsh_definitions","file":"lean/QuarticQuery/Paper/ConstructionForrelationDefinitions.lean"}],"relation_origin":"authored_review","semantic_examples":"none_indexed","type_and_axioms_origin":"compiled_lean_environment"},"section":"2.1","semantic_probes":[],"source_line":136,"statement":"m=4^t. H is the m x m normalized Walsh-Hadamard matrix, H_{a,b}=m^{-1/2}(-1)^{<a,b>} for a,b in {0,1}^{log_2 m}. u=m^{-1/2}(1,...,1)^T. A bit a is identified with the sign (-1)^a. For z in {+-1}^m, D_z=diag(z).","statement_sha256":"cea0c236eec7f144a63eb21757f43457a4d6562214b0ec6e2e96438e9fcbb7e1"}
