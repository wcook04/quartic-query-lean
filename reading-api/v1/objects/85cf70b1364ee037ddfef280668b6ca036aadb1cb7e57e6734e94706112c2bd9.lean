public import Mathlib

@[expose] public section

namespace QuarticQuery

open scoped BigOperators

/-! ## Inputs and functions -/

abbrev BitInput (ι : Type) := ι → Bool
abbrev TotalBool (ι : Type) := BitInput ι → Bool

/-- `none` marks an input outside the promise. -/
abbrev PartialBool (ι : Type) := BitInput ι → Option Bool

def totalise {ι : Type} (f : TotalBool ι) : PartialBool ι :=
  fun x => some (f x)

def promised {ι : Type} (f : PartialBool ι) (x : BitInput ι) : Prop :=
  ∃ b, f x = some b

/-- Renaming coordinates makes no queries, so it must preserve every cost. -/
def reindex {ι κ : Type} (e : ι ≃ κ) (f : PartialBool ι) : PartialBool κ :=
  fun x => f (fun i => x (e i))

/-! ## Worst-case classical bit queries -/

inductive QueryTree (ι : Type) where
  | leaf (answer : Bool)
  | query (index : ι) (onFalse onTrue : QueryTree ι)

def QueryTree.eval {ι : Type} : QueryTree ι → BitInput ι → Bool
  | .leaf b, _ => b
  | .query i l r, x => if x i then r.eval x else l.eval x

/-- The longest root-to-leaf path. Repeated queries are charged. -/
def QueryTree.depth {ι : Type} : QueryTree ι → ℕ
  | .leaf _ => 0
  | .query _ l r => 1 + max l.depth r.depth

/-- A finite mixture of decision trees. Every tree in the mixture has positive
probability, so worst-case depth below is over the support. -/
structure RandomizedProgram (ι : Type) where
  size : ℕ
  weight : Fin size → ℝ
  tree : Fin size → QueryTree ι
  weight_pos : ∀ j, 0 < weight j
  weight_sum : ∑ j, weight j = 1

def RandomizedProgram.depth {ι : Type} (A : RandomizedProgram ι) : ℕ :=
  Finset.univ.sup fun j => (A.tree j).depth

noncomputable def RandomizedProgram.success {ι : Type}
    (A : RandomizedProgram ι) (x : BitInput ι) (b : Bool) : ℝ :=
  ∑ j, if (A.tree j).eval x = b then A.weight j else 0

/-- Error at most 1/3 on every promised input within `budget` queries. -/
def RLe {ι : Type} (f : PartialBool ι) (budget : ℕ) : Prop :=
  ∃ A : RandomizedProgram ι,
    A.depth ≤ budget ∧ ∀ x b, f x = some b → (2 / 3 : ℝ) ≤ A.success x b

def DLe {ι : Type} (f : PartialBool ι) (budget : ℕ) : Prop :=
  ∃ tree : QueryTree ι,
    tree.depth ≤ budget ∧ ∀ x b, f x = some b → tree.eval x = b

/-- Randomized query complexity. `sInf ∅ = 0` in `ℕ`, so every lower bound is
proved through `RLe` and the read-all witness that makes this set nonempty. -/
noncomputable def R {ι : Type} [Fintype ι] (f : PartialBool ι) : ℕ :=
  sInf {t : ℕ | RLe f t}

noncomputable def D {ι : Type} [Fintype ι] (f : PartialBool ι) : ℕ :=
  sInf {t : ℕ | DLe f t}

/-! ## The bit oracle and adaptive quantum programs

The program, initial state, gates and output labels are chosen before the
input `x`. All access to `x` is through `bitOracle`. -/

abbrev Basis (ι : Type) (workspace : ℕ) := ι × Bool × Fin (workspace + 1)

abbrev State (ι : Type) [Fintype ι] (workspace : ℕ) :=
  EuclideanSpace ℂ (Basis ι workspace)

/-- `O_x |i, b, z⟩ = |i, b ⊕ x_i, z⟩`. The oracle is an involution, so
permuting amplitudes by it is the same as permuting basis vectors by it. -/
noncomputable def bitOracle {ι : Type} [Fintype ι] {w : ℕ}
    (x : BitInput ι) (ψ : State ι w) : State ι w :=
  WithLp.toLp 2 fun p =>
    ψ.ofLp (p.1, (if x p.1 then !p.2.1 else p.2.1), p.2.2)

open Classical in
noncomputable def project {ι : Type} [Fintype ι] {w : ℕ}
    (S : Finset (Basis ι w)) (ψ : State ι w) : State ι w :=
  WithLp.toLp 2 fun p => if p ∈ S then ψ.ofLp p else 0

/-- Finite classical control over unitary steps, oracle calls and binary
projective measurements. Computation between queries is unrestricted. -/
inductive AdaptiveProgram (ι : Type) [Fintype ι] (w : ℕ) where
  | output (answer : Bool)
  | unitary (U : State ι w →ₗᵢ[ℂ] State ι w) (next : AdaptiveProgram ι w)
  | query (next : AdaptiveProgram ι w)
  | measure (S : Finset (Basis ι w)) (yes no : AdaptiveProgram ι w)

/-- The query cap is syntactic: it bounds every branch on every input, including
inputs outside a promise. -/
def AdaptiveProgram.queryCap {ι : Type} [Fintype ι] {w : ℕ} :
    AdaptiveProgram ι w → ℕ
  | .output _ => 0
  | .unitary _ next => next.queryCap
  | .query next => 1 + next.queryCap
  | .measure _ yes no => max yes.queryCap no.queryCap

/-- Branch states stay unnormalised; a branch's probability is its squared norm. -/
noncomputable def AdaptiveProgram.outputMass {ι : Type} [Fintype ι] {w : ℕ} :
    AdaptiveProgram ι w → BitInput ι → State ι w → Bool → ℝ
  | .output answer, _, ψ, b => if answer = b then ‖ψ‖ ^ 2 else 0
  | .unitary U next, x, ψ, b => next.outputMass x (U ψ) b
  | .query next, x, ψ, b => next.outputMass x (bitOracle x ψ) b
  | .measure S yes no, x, ψ, b =>
      yes.outputMass x (project S ψ) b +
      no.outputMass x (ψ - project S ψ) b

/-- A constant answer needs no query register. This alternative also covers an
empty coordinate type, whose query register has no unit vector. -/
def ConstantOnPromise {ι : Type} (f : PartialBool ι) : Prop :=
  ∃ b : Bool, ∀ x c, f x = some c → c = b

def QLe {ι : Type} [Fintype ι] (f : PartialBool ι) (budget : ℕ) : Prop :=
  ConstantOnPromise f ∨
  ∃ (w : ℕ) (ψ₀ : State ι w) (A : AdaptiveProgram ι w),
    ‖ψ₀‖ = 1 ∧ A.queryCap ≤ budget ∧
    ∀ x b, f x = some b → (2 / 3 : ℝ) ≤ A.outputMass x ψ₀ b

noncomputable def Q {ι : Type} [Fintype ι] (f : PartialBool ι) : ℕ :=
  sInf {t : ℕ | QLe f t}

/-! ## Forrelation (Section 2.1)

`m = 2 ^ (2 * t)` is a power of four and `√m = 2 ^ t`, so the normalised value
`Φ = N / (m (√m)^(k-1))` and both thresholds are exact integer comparisons. -/

/-- The number of columns: a power of four. -/
def mValue (t : ℕ) : ℕ := 2 ^ (2 * t)

abbrev ForrelationCoord (k t : ℕ) := Fin k × Fin (mValue t)

/-- A bit `a` stands for the sign `(-1)^a`. -/
def bitSign (b : Bool) : ℤ := if b then -1 else 1

/-- Entry of `√m H`, the unnormalised Walsh–Hadamard matrix. -/
def walshSign (t : ℕ) (i j : Fin (mValue t)) : ℤ :=
  (-1 : ℤ) ^ (∑ b ∈ Finset.range (2 * t),
    if i.val.testBit b && j.val.testBit b then (1 : ℕ) else 0)

/-- `N = z₁ᵀ W D_{z₂} W ⋯ W D_{z_k} (1, …, 1)ᵀ`, expanded over paths. -/
def forrelationNumerator (k t : ℕ) (z : BitInput (ForrelationCoord k t)) : ℤ :=
  ∑ path : Fin k → Fin (mValue t),
    (∏ h : Fin k, bitSign (z (h, path h))) *
    (∏ h : Fin (k - 1),
      walshSign t (path ⟨h.val, Nat.lt_of_lt_of_le h.isLt (Nat.sub_le k 1)⟩)
        (path ⟨h.val + 1, Nat.add_lt_of_lt_sub h.isLt⟩))

/-- `M = m (√m)^(k-1)`. -/
def forrelationDenominator (k t : ℕ) : ℤ :=
  (2 : ℤ) ^ (2 * t) * ((2 : ℤ) ^ t) ^ (k - 1)

noncomputable def Phi (k t : ℕ) (z : BitInput (ForrelationCoord k t)) : ℝ :=
  (forrelationNumerator k t z : ℝ) / (forrelationDenominator k t : ℝ)

/-- Equation (4) with `δ = 2^(-5k)`, written as the exact integer tests of
Lemma 2.1(iii). A large negative value of `Φ` is outside the promise. -/
def P (k t : ℕ) : PartialBool (ForrelationCoord k t) := fun z =>
  let N := forrelationNumerator k t z
  let M := forrelationDenominator k t
  if (2 : ℤ) ^ (5 * k) * N ≥ M then some true
  else if (2 : ℤ) ^ (5 * k + 1) * |N| ≤ M then some false
  else none

/-! ## Fan-in-two circuits and transcripts

`none` is a constant-false predecessor, so a two-input table realises constants
and unary gates too. Every stored gate has one transcript bit; input bits are
read from the input, never copied. -/

structure Gate (ι : Type) (earlier : ℕ) where
  left : Option (ι ⊕ Fin earlier)
  right : Option (ι ⊕ Fin earlier)
  table : Bool → Bool → Bool

structure Circuit (ι : Type) where
  size : ℕ
  gate : (g : Fin size) → Gate ι g.val
  domainOut : Fin size
  valueOut : Fin size

def predecessorValue {ι : Type} (C : Circuit ι) (x : BitInput ι)
    (tr : Fin C.size → Bool) (g : Fin C.size) :
    Option (ι ⊕ Fin g.val) → Bool
  | none => false
  | some (.inl i) => x i
  | some (.inr h) => tr ⟨h.val, lt_trans h.isLt g.isLt⟩

/-- Every claimed gate value is the prescribed function of its predecessors. -/
def GateConsistent {ι : Type} (C : Circuit ι) (x : BitInput ι)
    (tr : Fin C.size → Bool) : Prop :=
  ∀ g, tr g = (C.gate g).table
    (predecessorValue C x tr g (C.gate g).left)
    (predecessorValue C x tr g (C.gate g).right)

/-- Lemma 2.1(iii): `d = 1` iff the function is defined, and `d = 1` implies
`b` is its value, on every input. -/
structure CircuitRealises {ι : Type} (C : Circuit ι) (f : PartialBool ι) : Prop where
  exists_transcript : ∀ x, ∃ tr, GateConsistent C x tr
  correct : ∀ x tr, GateConsistent C x tr →
    (tr C.domainOut = true ↔ promised f x) ∧
    (tr C.domainOut = true → f x = some (tr C.valueOut))

/-! ## The addressed total function (Section 2.2)

Stated for any partial function `f` on `κ`, any circuit `C` and any address
length `r`, with `2 ^ ℓ` columns. Pointers are physical bits, each column has its
own array of `2 ^ r` cells, and no promise is made about any bit. -/

abbrev Column (ℓ : ℕ) := Fin (2 ^ ℓ)
abbrev Address (r : ℕ) := Fin r → Bool

/-- The four kinds of input bit: the strings `X_i`; the strings `A_{i,h}`; the
pointer bits of each cell; the transcript bits of each cell. -/
abbrev BitLoc (ℓ r S : ℕ) (κ : Type) :=
  (Column ℓ × Column ℓ) ⊕
  (Column ℓ × Fin r × κ) ⊕
  (Σ i : Column ℓ, Address r × {j : Column ℓ // j ≠ i} × Fin ℓ) ⊕
  (Column ℓ × Address r × Fin r × Fin S)

section Reads

variable {ℓ r S : ℕ} {κ : Type} (x : BitInput (BitLoc ℓ r S κ))

def readX (i j : Column ℓ) : Bool := x (.inl (i, j))

def readA (i : Column ℓ) (h : Fin r) : BitInput κ :=
  fun q => x (.inr (.inl (i, h, q)))

def readPointerBit (i : Column ℓ) (s : Address r)
    (j : {j : Column ℓ // j ≠ i}) (b : Fin ℓ) : Bool :=
  x (.inr (.inr (.inl ⟨i, (s, j, b)⟩)))

def readTranscript (i : Column ℓ) (s : Address r) (h : Fin r) : Fin S → Bool :=
  fun g => x (.inr (.inr (.inr (i, s, h, g))))

end Reads

/-- The fixed bijection between `ℓ`-bit strings and `2 ^ ℓ` columns. -/
def pointerEquiv (ℓ : ℕ) : (Fin ℓ → Bool) ≃ Column ℓ :=
  (Equiv.arrowCongr (Equiv.refl _) finTwoEquiv.symm).trans finFunctionFinEquiv

/-- Column `i` is a winner with true address `s`: `X_i` is all ones, every
`f(A_{i,h})` is defined and equals `s h`, the cell at `s` holds correct
transcripts, and its pointers find a zero in every other column. These are the
conditions around (7) and (8). -/
def WinsAt {κ : Type} (f : PartialBool κ) (C : Circuit κ) (ℓ r : ℕ)
    (x : BitInput (BitLoc ℓ r C.size κ)) (i : Column ℓ) (s : Address r) : Prop :=
  (∀ j, readX x i j = true) ∧
  (∀ h, f (readA x i h) = some (s h)) ∧
  (∀ h, GateConsistent C (readA x i h) (readTranscript x i s h)) ∧
  (∀ j : {j : Column ℓ // j ≠ i},
    readX x j.val (pointerEquiv ℓ (readPointerBit x i s j)) = false)

open Classical in
/-- The total function: does a winner exist? -/
noncomputable def addressedF {κ : Type} (f : PartialBool κ) (C : Circuit κ) (ℓ r : ℕ) :
    TotalBool (BitLoc ℓ r C.size κ) :=
  fun x => decide (∃ i s, WinsAt f C ℓ r x i s)

/-- `F_{k,m}` for `m = 4 ^ t`: `ℓ = log₂ m = 2t` and `r = ⌈20 log₂ m⌉ = 40t`.
`C` stays a parameter because the preprint specifies a construction scheme, not
one gate numbering. Family theorems quantify over circuits realising `P`. -/
noncomputable def Fkm (k t : ℕ) (C : Circuit (ForrelationCoord k t)) :
    TotalBool (BitLoc (2 * t) (40 * t) C.size (ForrelationCoord k t)) :=
  addressedF (P k t) C (2 * t) (40 * t)

/-! ## Comparison tournaments (Section 3.2) -/

/-- Equation (10): comparison probabilities are complementary, and no candidate
beats itself. No order or transitivity is assumed. -/
structure Tournament.IsComparison {ι : Type} (a : ι → ι → ℝ) : Prop where
  complementary : ∀ i j, i ≠ j → a i j + a j i = 1
  self_zero : ∀ i, a i i = 0

/-! ## Parameters and headline statements -/

/-- `L = ⌊m^(1-1/k) / (log₂ m)²⌋`, equation (5). -/
noncomputable def Lvalue (k t : ℕ) : ℕ :=
  ⌊Real.rpow (mValue t : ℝ) (1 - 1 / (k : ℝ)) /
    (Real.logb 2 (mValue t : ℝ)) ^ 2⌋₊

/-- `G = ⌊mL/100⌋`, equation (17). -/
def Gvalue (m L : ℕ) : ℕ := m * L / 100

/-- The external input of Lemma 2.1(i): the Bansal–Sinha randomized lower bound
for exactly this `P`, in exactly this query model. It is used as a named
hypothesis and is never an axiom. -/
def BansalSinhaLower : Prop :=
  ∀ k : ℕ, 2 ≤ k → ∃ t₀ : ℕ, ∀ t : ℕ, t₀ ≤ t → Lvalue k t < R (P k t)

/-- The membership condition of equation (1). -/
def UniversalPower (α : ℝ) : Prop :=
  0 ≤ α ∧ ∃ C : ℝ, 0 < C ∧
    ∀ n : ℕ, 1 ≤ n → ∀ f : TotalBool (Fin n),
      (R (totalise f) : ℝ) ≤ C * Real.rpow (1 + (Q (totalise f) : ℝ)) α

/-- `α_tot`, equation (1). -/
noncomputable def alphaTot : ℝ := sInf {α : ℝ | UniversalPower α}

end QuarticQuery

@[expose] public section

namespace QuarticQuery.Checked

theorem alphaTot_eq_four_of_bansalSinha (h : BansalSinhaLower) : alphaTot = 4 := by
  sorry
theorem theorem_1_1 (h : BansalSinhaLower) :
    alphaTot = 4 ∧ UniversalPower 4 ∧
      ∀ k : ℕ, 2 ≤ k → ∃ (S A : ℕ) (b : ℕ), 0 < A ∧ ∀ t, 1 ≤ t →
        ∃ C : Circuit (ForrelationCoord k t), CircuitRealises C (P k t) ∧
          C.size ≤ S * mValue t * (2 * t) ^ 2 ∧
          (Q (totalise (Fkm k t C)) : ℝ) ≤ (A : ℝ) * 2 ^ t * (2 * (t : ℝ)) ^ b ∧
          (8 ≤ t → Lvalue k t < R (P k t) →
            Gvalue (mValue t) (Lvalue k t) < R (totalise (Fkm k t C))) := by
  sorry
theorem universal_quartic_bound : UniversalPower 4 := by
  sorry
theorem cubic_bound_fails_of_bansalSinha (h : BansalSinhaLower) :
    ¬ ∃ C : ℝ, ∀ n : ℕ, 1 ≤ n → ∀ f : TotalBool (Fin n),
      (R (totalise f) : ℝ) ≤ C * (Q (totalise f) : ℝ) ^ 3 := by
  sorry
theorem family_bounds (k : ℕ) (hk : 2 ≤ k) :
    ∃ (S A : ℕ) (b : ℕ), 0 < A ∧ ∀ t, 1 ≤ t →
      ∃ C : Circuit (ForrelationCoord k t), CircuitRealises C (P k t) ∧
        C.size ≤ S * mValue t * (2 * t) ^ 2 ∧
        (Q (totalise (Fkm k t C)) : ℝ) ≤ (A : ℝ) * 2 ^ t * (2 * (t : ℝ)) ^ b ∧
        (8 ≤ t → Lvalue k t < R (P k t) →
          Gvalue (mValue t) (Lvalue k t) < R (totalise (Fkm k t C))) := by
  sorry
theorem addressed_lower_bound {κ : Type} [Fintype κ] [DecidableEq κ] (f : PartialBool κ)
    (C : Circuit κ) (hC : CircuitRealises C f) {t L : ℕ} (hL1 : 1 ≤ L) (hLm : L ≤ mValue t)
    (hLR : L < R f) :
    Gvalue (mValue t) L < R (totalise (addressedF f C (2 * t) (40 * t))) := by
  sorry

end QuarticQuery.Checked
