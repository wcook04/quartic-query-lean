/Amplification/Bounded.lean","hypotheses":[],"inspection":null,"kind":"def","line":178,"note":"Definition of failure probability.","open_assumptions":[],"premises":[],"reached":false,"relation":"unassessed","review_evidence":"legacy_unbound","reviewed_by":"ai:truth-auditor","reviewed_relation":"partial","reviewed_route":"none","route":"unassessed","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_credit":"none","comparison_evidence":"not_run","configured_checks":[],"declaration":"QuarticQuery.Amplification.Proc.conditional","declaration_lines":[181,183],"file":"lean/QuarticQuery/Amplification/Bounded.lean","hypotheses":[],"inspection":null,"kind":"def","line":182,"note":"Definition of conditional payoff.","open_assumptions":[],"premises":[],"reached":false,"relation":"unassessed","review_evidence":"legacy_unbound","reviewed_by":"ai:truth-auditor","reviewed_relation":"partial","reviewed_route":"none","route":"unassessed","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_credit":"none","comparison_evidence":"not_run","configured_checks":[],"declaration":"QuarticQuery.Amplification.expect_attempts_of_phase","declaration_lines":[198,209],"file":"lean/QuarticQuery/Amplification/Bounded.lean","hypotheses":[],"inspection":null,"kind":"theorem","line":200,"note":"Phase-blind payoffs see one state.","open_assumptions":[],"premises":[],"reached":false,"relation":"unassessed","review_evidence":"legacy_unbound","reviewed_by":"ai:truth-auditor","reviewed_relation":"partial","reviewed_route":"same","route":"unassessed","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_credit":"none","comparison_evidence":"not_run","configured_checks":[],"declaration":"QuarticQuery.Amplification.bounded_amplification","declaration_lines":[238,293],"file":"lean/QuarticQuery/Amplification/Bounded.lean","hypotheses":[],"inspection":{"axioms":["Classical.choice","Quot.sound","propext"],"module":"QuarticQuery.Amplification.Bounded","receipt":"corpus/reading_statement_evidence.json","status":"current","type":"∀ {γ η : ℝ},\n  0 < γ →\n    γ ≤ 1 / 2 →\n      0 < η →\n        η < 1 / 2 →\n          (QuarticQuery.Amplification.amplify γ η).callCap ≤\n              QuarticQuery.Amplification.trialCount η * (2 * QuarticQuery.Amplification.iterationBound γ + 1) ∧\n            ↑(QuarticQuery.Amplification.amplify γ η).callCap ≤ 138 * (√γ)⁻¹ * Real.log (1 / η) ∧\n              ∀ {H : Type u} [inst : NormedAddCommGroup H] [inst_1 : InnerProductSpace ℂ H]\n                (A : QuarticQuery.Amplification.Preparation H),\n                (QuarticQuery.Amplification.amplify γ η).successProb A +\n                      (QuarticQuery.Amplification.amplify γ η).failProb A =\n                    1 ∧\n                  (∀ (h : Option H → ℝ),\n                      QuarticQuery.Amplification.PhaseInvariant h →\n                        QuarticQuery.Amplification.Proc.expect A h (QuarticQuery.Amplification.amplify γ η) A.zero =\n                          (QuarticQuery.Amplification.amplify γ η).successProb A * h (Option.some A.goodState) +\n                            (QuarticQuery.Amplification.amplify γ η).failProb A * h Option.none) ∧\n                    (∀ (k : H → ℝ),\n                        (∀ (c : ℂ), ‖c‖ = 1 → ∀ (v : H), k (c • v) = k v) →\n                          (QuarticQuery.Amplification.amplify γ η).successProb A ≠ 0 →\n                            (QuarticQuery.Amplification.amplify γ η).conditional A k = k A.goodState) ∧\n                      (QuarticQuery.Amplification.amplify γ η).wrongStateMass A = 0 ∧\n                        (γ ≤ A.prob → (QuarticQuery.Amplification.amplify γ η).failProb A ≤ η) ∧\n                          (A.prob = 0 → (QuarticQuery.Amplification.amplify γ η).failProb A = 1)"},"kind":"theorem","line":242,"note":"One Proc amplify γ η is fixed before A and has syntactic all-branch call cap ≤138(√γ)⁻¹ log(1/η). Its phase-invariant state payoff law, zero wrong-state mass, conditional good-state law when success mass is nonzero, failure ≤η for p≥γ, and failure=1 for p=0 cover the row in the abstract Proc semantics. Proc.restart resets the branch vector; this theorem does not itself compile that semantics into the physical bit-query model or identify the output subsystem of the separate label-law implementation.","open_assumptions":[],"premises":["0<γ≤1/2; 0<η<1/2; arbitrary complex inner-product space and Preparation."],"reached":false,"relation":"exact","review_binding":{"declaration":"QuarticQuery.Amplification.bounded_amplification","judgment_sha256":"a46bfdb78cec4662c4748eb0f96a195a05ff736ca258c68db6c2f03866df538b","row_sha256":"29e1e94b1f339895a1adde650482c8499255705e4ec49fcfa139ef3e64450649","schema":"quartic-tie-review-v1","source_snapshot_sha256":"0d109ea9e9b7f4a766640d406409e30589fb4c5a4e645b6d6888569fa2edf29f","statement_id":"lem-3.1","statement_sha256":"b76e3c7f8a37dd0cdf934b72d91d1ad52678f354374884a3666bc12236871ec8"},"review_evidence":"current","reviewed_by":"ai:round3-foundation-source-review","reviewed_relation":"exact","reviewed_route":"same","route":"same","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_credit":"none","comparison_evidence":"not_run","configured_checks":[],"declaration":"QuarticQuery.Amplification.IndexRegister","declaration_lines":[297,307],"file":"lean/QuarticQuery/Amplification/Bounded.lean","hypotheses":[],"inspection":null,"kind":"structure","line":300,"note":"Index register structure for Proposition 3.2.","open_assumptions":[],"premises":[],"reached":false,"relation":"unassessed","review_evidence":"legacy_unbound","reviewed_by":"ai:truth-auditor","reviewed_relation":"partial","reviewed_route":"none","route":"unassessed","wrapper_comparison_evidence":"not_run"},{"build_evidence":"current","built":true,"compared":false,"comparison_cr