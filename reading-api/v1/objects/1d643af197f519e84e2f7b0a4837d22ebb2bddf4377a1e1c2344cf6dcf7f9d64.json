ery/output alphabets; inhabited query type; coherent Samples n L witness; M!=0."],"reached":false,"relation":"unassessed","review_evidence":"legacy_unbound","reviewed_by":"ai:round2-construction-quantum-source-review","reviewed_relation":"partial","reviewed_route":"same","route":"unassessed","wrapper_comparison_evidence":"not_run"}],"ledger_history":{"added_in_review":false,"adjudication_findings":[{"claim":"Lemma 3.1 hides a quantifier: the procedure must be black-box in A, with call counts depending only on gamma, eta.","id":"M-1","paper_locus":"Lemma 3.1 lines 310-320; line 354 'Fix an input' and line 361 'pointwise'","reason":"Read literally, 'there is a procedure' for a given A allows dependence on p or theta, which depend on the oracle input and would break the query model. The proof is uniform (M, trial count). Prop 3.2 has the same literal issue; r3 flagged the order there, no return flagged it for Lemma 3.1. Needed: exists procedure, for all A.","verdict":"accepted"}],"earlier_ledger_wording":null,"wording_changed":false},"original_statement_sha256":"e238b2bb8394f028e9b054ea5210a7afb2db326a3fda5517906ef3667d51cd34","passages":["upper-grover-trial","CAT-def-grover-trial"],"review_scope":{"compared_text":"maintained_ledger_statement","leading_matches":[{"declaration":"QuarticQuery.Paper.quantum_grover_parameters","file":"lean/QuarticQuery/Paper/QuantumAmplification.lean"},{"declaration":"QuarticQuery.Paper.quantum_grover_trial_distribution","file":"lean/QuarticQuery/Paper/QuantumAmplification.lean"},{"declaration":"QuarticQuery.Paper.quantum_grover_trial_recursion","file":"lean/QuarticQuery/Paper/QuantumAmplification.lean"}],"relation_origin":"authored_review","semantic_examples":"none_indexed","type_and_axioms_origin":"compiled_lean_environment"},"section":"3.1","semantic_probes":[],"source_line":332,"statement":"M = ceil(10/sqrt(gamma)). A trial picks with probability 1/2 l=0, and with probability 1/2 a uniform l in {0,...,M-1}, applies l Grover iterations 