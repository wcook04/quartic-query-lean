ote":"The exact ratio conditions on an actual adaptive transcript prefix and assigns 1/card(unqueriedRows) to each unqueried position, zero elsewhere. Prefix definitions include the schedule and the returned answers; repeated queries remove a row only once.","open_assumptions":[],"premises":["Nonnegative normalized address prior; no zero seen in the selected column; positive dummy transcript mass."],"reached":false,"relation":"exact","review_binding":{"declaration":"QuarticQuery.Paper.uniform_zero_given_transcript","judgment_sha256":"029985c33cda541808e3bb74090201345d831a786a7fd834959e726b74bf8c4c","row_sha256":"e77ea114f6d38f1af0c99b4457daebb6b18ed264024430ba7d1c9233d26bef7c","schema":"quartic-tie-review-v1","source_snapshot_sha256":"0d109ea9e9b7f4a766640d406409e30589fb4c5a4e645b6d6888569fa2edf29f","statement_id":"claim-uniform-zero","statement_sha256":"64fa654dd348407f698a46f54a8ad93346c9a6f4f603206aab2b7906e7713676"},"review_evidence":"current","reviewed_by":"ai:round3-construction-source-review","reviewed_relation":"exact","reviewed_route":"same","route":"same","wrapper_comparison_evidence":"not_run"}],"ledger_history":{"added_in_review":false,"adjudication_findings":[],"earlier_ledger_wording":null,"wording_changed":false},"original_statement_sha256":"64fa654dd348407f698a46f54a8ad93346c9a6f4f603206aab2b7906e7713676","passages":["CL-early-late","CAT-claim-uniform-zero"],"presentation":{"body":"Before a column’s zero is found, its position is uniform among that column’s unqueried positions, conditional on the full adaptive transcript.","body_plain":"Before a column’s zero is found, its position is uniform among that column’s unqueried positions, conditional on the full adaptive transcript.","statement_sha256":"64fa654dd348407f698a46f54a8ad93346c9a6f4f603206aab2b7906e7713676","title":"An undiscovered zero remains uniform over unqueried positions","title_plain":"An undiscovered zero remains uniform over unqueried positions"},"review_scope":{"compared_text":"maintained_ledger_statement","leading_matches":[{"declaration":"QuarticQuery.Paper.uniform_zero_given_transcript","file":"lean/QuarticQuery/Paper/ClassicalUniformZero.lean"}],"relation_origin":"authored_review","semantic_examples":"none_indexed","type_and_axioms_origin":"compiled_lean_environment"},"section":"4.2","semantic_probes":[],"source_line":619,"statement":"Before the zero in a column is found, its location is uniform among positions of that column not yet queried, conditional on the full adaptive transcript.","statement_sha256":"64fa654dd348407f698a46f54a8ad93346c9a6f4f603206aab2b7906e7713676"}
