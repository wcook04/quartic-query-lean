:{"axioms":["Classical.choice","Quot.sound","propext"],"module":"QuarticQuery.Paper.ConstructionForrelationDefinitions","receipt":"corpus/reading_statement_evidence.json","status":"current","type":"∀ (k t : ℕ) (z : QuarticQuery.BitInput (QuarticQuery.ForrelationCoord k t)),\n  Fintype.card (QuarticQuery.ForrelationCoord k t) = k * QuarticQuery.mValue t ∧\n    (QuarticQuery.P k t z = Option.some Bool.true ↔ QuarticQuery.Forrelation.delta k ≤ QuarticQuery.Phi k t z) ∧\n      (QuarticQuery.P k t z = Option.some Bool.false ↔\n          |QuarticQuery.Phi k t z| ≤ QuarticQuery.Forrelation.delta k / 2) ∧\n        (QuarticQuery.P k t z = Option.none ↔\n            ¬QuarticQuery.Forrelation.delta k ≤ QuarticQuery.Phi k t z ∧\n              ¬|QuarticQuery.Phi k t z| ≤ QuarticQuery.Forrelation.delta k / 2) ∧\n          ¬(QuarticQuery.Forrelation.delta k ≤ QuarticQuery.Phi k t z ∧\n              |QuarticQuery.Phi k t z| ≤ QuarticQuery.Forrelation.delta k / 2)"},"kind":"theorem","line":59,"note":"The cardinality, true, false and undefined cases and disjointness appear together; P is implemented by the integer tests, proved equivalent here.","open_assumptions":[],"premises":["m = 4^t."],"reached":false,"relation":"exact","review_binding":{"declaration":"QuarticQuery.Paper.construction_equation_4","judgment_sha256":"96259c980877e4ea917efbde6177dac3bf78f5f45f9b5978e5a76e0eaccf092f","row_sha256":"b5a9d0761399095b88fea5d7bbef25c6c3f2b1c93275c48115d5afbf4a126b16","schema":"quartic-tie-review-v1","source_snapshot_sha256":"0d109ea9e9b7f4a766640d406409e30589fb4c5a4e645b6d6888569fa2edf29f","statement_id":"eq-4","statement_sha256":"d851c47d1b5c5d998eb9c90a501c8a57e7bdb071021c6e7adbac48e388ff6483"},"review_evidence":"current","reviewed_by":"ai:round3-foundation-source-review","reviewed_relation":"exact","reviewed_route":"same","route":"same","wrapper_comparison_evidence":"not_run"}],"ledger_history":{"added_in_review":false,"adjudication_findings":[{"claim":"The imported Forrelation bound m