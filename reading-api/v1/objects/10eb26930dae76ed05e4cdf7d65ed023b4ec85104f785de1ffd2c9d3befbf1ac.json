ioms":["Classical.choice","Quot.sound","propext"],"module":"QuarticCorpus.Independent.SemanticMutations","receipt":"corpus/reading_statement_evidence.json","status":"current","type":"QuarticQuery.SemanticReview.absoluteHighPromise 2 1 QuarticQuery.SemanticReview.negativePair ≠\n  QuarticQuery.P 2 1 QuarticQuery.SemanticReview.negativePair"},"kind":"alternative_definition","lines":[54,57],"question":"Would taking the absolute value on the high branch accept a negative instance?","receipt":"corpus/receipts/lean-build-round3-targeted-2026-11-02T204814950389+0000.json","receipt_currentness":"stale","recorded_status":"passed","source":"lean/QuarticCorpus/Independent/SemanticMutations.lean"}],"source_line":145,"statement":"P=P_{k,m} is the partial function on km bits with P=1 if Phi>=delta, P=0 if |Phi|<=delta/2, undefined otherwise. The two cases are disjoint.","statement_sha256":"d851c47d1b5c5d998eb9c90a501c8a57e7bdb071021c6e7adbac48e388ff6483"}
