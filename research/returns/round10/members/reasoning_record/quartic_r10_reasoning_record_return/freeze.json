    {
      "id": "PD-02",
      "requirement": "Meaning-based sentence rows with individual cognitive annotations",
      "actual": "Heuristic splitting yielded 3260 sentence candidates. 975 blocks carry shared content-specific notes; 1586 rows are explicitly index-only.",
      "effect": "4262 rows are an inventory, not 4262 independent observations or a completeness certificate.",
      "evidence": "first_pass/coverage.json"
    },
    {
      "id": "PD-03",
      "requirement": "No external or retrospective material before the first-pass freeze",
      "actual": "The primary did not open those sources. Separate agents and the integrating reviewer read source-only literature and selected code concurrently before the freeze; those results were withheld from the primary. Root prepared historical/current passage pairings without supplying them to the primary.",
      "effect": "The primary context firewall was maintained, but literal global embargo across all workers was not. No claim of full procedural compliance is made.",
      "evidence": "supporting_reviews/*_scope*.json; sources/; reading_log.md"
    },
    {
      "id": "PD-04",
      "requirement": "Attempt questions before seeing answers",
      "actual": "Worked examples and answers were visible during the textual pass. No isolated cold attempts were recorded. Later mathematical reconstruction was source-informed.",
      "effect": "Answer-exposed reading, not evidence of independent student exercise success.",
      "evidence": "first_pass/coverage.json; first_pass/batches/"
    },
    {
      "id": "PD-05",
      "requirement": "Independent reader perspectives and first exposure",
      "actual": "All readers are AI simulations. The primary inherited limited R8/R9 procedural themes; specialists had source preparation and later context. Lead specialist rereads were serial; historical cross-document audits ran in parallel after the freeze.",
      "effect": "Do not treat perspectives as blind human replicates or combine their reading histories into one cold pass.",
      "evidence": "first_pass/README.md; supporting_reviews/quantum_scopes_read.json; supporting_reviews/classical_review_scope.json; supporting_reviews/formal_review_scope.json; supporting_reviews/ex9_scopes_read.json"
    }
  ],
